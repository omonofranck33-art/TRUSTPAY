<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml = la "liste de courses" de Maven : il dit quelles bibliothèques télécharger -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot fournit une configuration prête à l'emploi -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
  </parent>

  <groupId>cm.trustpay</groupId>
  <artifactId>trustpay-backend</artifactId>
  <version>0.1.0</version>

  <properties>
    <java.version>17</java.version> <!-- Java 17 minimum (les "record" en ont besoin) -->
  </properties>

  <dependencies>
    <dependency> <!-- Crée le serveur web et les URL /api/... -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency> <!-- Outil JdbcTemplate pour parler à MySQL avec du SQL -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency> <!-- Pilote qui connecte Java à MySQL -->
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin> <!-- Permet de lancer avec : mvn spring-boot:run -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
